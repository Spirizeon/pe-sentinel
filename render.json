{
  "services": [
    {
      "type": "web",
      "name": "pe-sentinel",
      "runtime": "python",
      "plan": "free",
      "region": "oregon",
      "branch": "main",
      "buildCommand": "pip install -r requirements.txt",
      "startCommand": "python -m src.cli ui --host 0.0.0.0 --port $PORT",
      "healthCheckPath": "/api/health",
      "envVars": [
        {
          "key": "PYTHON_VERSION",
          "value": "3.12.7"
        },
        {
          "key": "PYTHONUNBUFFERED",
          "value": "1"
        }
      ]
    }
  ]
}
